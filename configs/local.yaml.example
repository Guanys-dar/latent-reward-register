# Copy to configs/local.yaml and fill in for your machine. Never committed.
# Keeping machine-specific values here is what lets every code and config file
# remain portable across machines.

# Root that manifest-relative paths resolve against.
data_root: /path/to/prepared_data

# Directory holding register checkpoints.
checkpoint_root: /path/to/checkpoints

# Local model snapshots, or replace these paths with Hugging Face model IDs.
models:
  sd3: /path/to/stable-diffusion-3-medium-diffusers
  flux: /path/to/FLUX.1-dev

# Optional experiment tracking. Leave blank to disable.
tracking:
  backend: ""
  project: ""
